# Copia este archivo a .env y completa los valores:

#CONFIGURACIÓN DE BASE DE DATOS (MariaDB)
DB_URL=jdbc:mariadb://localhost:3306/bibliotech_db
DB_USERNAME=tu_usuario_aqui
DB_PASSWORD=tu_contraseña_aqui

# Clave secreta (HS256 requiere al menos 256 bits / 32+ caracteres)
JWT_KEY=genera_una_clave_con_openssl_rand_base64_48

# Expiración del token JWT en milisegundos (3600000 = 1 hora)
JWT_EXPIRATION=3600000
